<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AI Camera & Gallery</title>
    <style>
        :root { --primary: #00ea7f; --bg: #000; }
        body {
            margin: 0; font-family: sans-serif; background: var(--bg); color: white;
            display: flex; flex-direction: column; height: 100vh; overflow: hidden;
        }

        /* Viewer (Camera or Uploaded Image) */
        #viewer-container {
            position: relative; flex-grow: 1; display: flex; justify-content: center; align-items: center; background: #111;
        }
        video, #preview-img {
            width: 100%; height: 100%; object-fit: cover; position: absolute;
        }
        #preview-img { display: none; } /* Hidden until a photo is picked */

        /* Overlay */
        #overlay { position: absolute; top: 20px; left: 15px; right: 15px; pointer-events: none; z-index: 10; }
        .advice-card {
            background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(10px);
            border-left: 5px solid var(--primary); padding: 15px; border-radius: 12px;
        }
        .status-badge {
            display: inline-block; background: var(--primary); color: black;
            padding: 3px 10px; border-radius: 20px; font-weight: bold; font-size: 0.75rem; margin-bottom: 8px;
        }

        /* Controls */
        #controls {
            background: white; color: black; padding: 20px 20px 40px 20px;
            border-radius: 24px 24px 0 0; display: flex; flex-direction: column; gap: 15px; z-index: 20;
        }
        .btn-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
        select { flex-grow: 1; padding: 12px; border-radius: 10px; border: 1px solid #ddd; }
        
        .icon-btn {
            background: #eee; border: none; padding: 10px; border-radius: 10px; cursor: pointer; font-size: 1.2rem;
        }

        .shutter-row { display: flex; justify-content: space-around; align-items: center; width: 100%; }
        .shutter-btn {
            width: 70px; height: 70px; background: white; border: 5px solid #ddd; border-radius: 50%;
        }
        .shutter-inner { width: 50px; height: 50px; background: #333; border-radius: 50%; margin: 5px auto; }

        /* Hidden File Input */
        #file-input { display: none; }
    </style>
</head>
<body>

    <div id="viewer-container">
        <video id="webcam" autoplay playsinline></video>
        <img id="preview-img" alt="Preview">
        
        <div id="overlay">
            <div class="advice-card">
                <div class="status-badge" id="status">AI 待機中</div>
                <div id="advice-text">モードを選択してください</div>
            </div>
        </div>
    </div>

    <div id="controls">
        <div class="btn-row">
            <select id="goal-select" onchange="updateAdvice()">
                <option value="none">📸 モード選択</option>
                <option value="chin">二重あご解消</option>
                <option value="slim">−5kg見え効果</option>
                <option value="legs">足長効果</option>
            </select>
            <button class="icon-btn" onclick="toggleCamera()">🔄</button>
        </div>

        <div class="shutter-row">
            <!-- Gallery Button -->
            <button class="icon-btn" onclick="document.getElementById('file-input').click()">🖼️ アルバム</button>
            
            <!-- Shutter Button -->
            <button class="shutter-btn" onclick="takePhoto()">
                <div class="shutter-inner"></div>
            </button>

            <!-- Reset to Live Camera -->
            <button class="icon-btn" onclick="resetToCamera()">📷 カメラ</button>
        </div>
    </div>

    <!-- HTML Hidden input to trigger Camera Roll -->
    <input type="file" id="file-input" accept="image/*" onchange="loadPhoto(event)">
    <canvas id="capture-canvas" style="display:none;"></canvas>

    <script>
        const video = document.getElementById('webcam');
        const previewImg = document.getElementById('preview-img');
        const adviceText = document.getElementById('advice-text');
        const statusBadge = document.getElementById('status');
        
        let useFrontCamera = true;

        // 1. Start Camera
        async function initCamera() {
            previewImg.style.display = 'none';
            video.style.display = 'block';
            const constraints = { video: { facingMode: useFrontCamera ? "user" : "environment" } };
            try {
                const stream = await navigator.mediaDevices.getUserMedia(constraints);
                video.srcObject = stream;
            } catch (err) { alert("カメラエラー"); }
        }

        // 2. Load from Camera Roll
        function loadPhoto(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    video.style.display = 'none';
                    previewImg.src = e.target.result;
                    previewImg.style.display = 'block';
                    adviceText.innerHTML = "写真を取り込みました。この写真のアドバイスを表示します...";
                };
                reader.readAsDataURL(file);
            }
        }

        function resetToCamera() {
            initCamera();
        }

        function toggleCamera() {
            useFrontCamera = !useFrontCamera;
            initCamera();
        }

        // --- AI Advice Logic ---
        const adviceDatabase = {
            chin: ["カメラを少し高く...", "あごを引いて...", "ベストショット！"],
            slim: ["斜めに立って...", "肩を下げて...", "スッキリ見えます！"],
            legs: ["カメラを低く...", "つま先を前に...", "足長効果MAX！"]
        };

        function updateAdvice() {
            let goal = document.getElementById('goal-select').value;
            if (goal === "none") return;
            let step = 0;
            statusBadge.style.background = "#00ea7f";
            statusBadge.innerText = "AI 分析中";
            
            const interval = setInterval(() => {
                adviceText.innerText = adviceDatabase[goal][step];
                step++;
                if (step >= adviceDatabase[goal].length) {
                    clearInterval(interval);
                    statusBadge.innerText = "完了";
                    statusBadge.style.background = "#00c3ff";
                }
            }, 2000);
        }

        function takePhoto() {
            alert("写真を保存しました！");
        }

        initCamera();
    </script>
</body>
</html>
